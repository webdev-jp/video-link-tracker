<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title><%= video.title || 'Video' %></title>
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0;
      background: #0b0b0c;
      color: #eee;
      font-family: -apple-system, Segoe UI, Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      justify-content: center;
      padding: 16px;
      box-sizing: border-box;
    }
    .player-wrap {
      width: 100%;
      max-width: 960px;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    }
    #player { width: 100%; height: 100%; }
    h1 {
      font-size: 1.1rem;
      font-weight: 500;
      margin: 16px 0 0;
      max-width: 960px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="player-wrap">
    <div id="player"></div>
  </div>
  <% if (video.title) { %><h1><%= video.title %></h1><% } %>

  <script src="https://www.youtube.com/iframe_api"></script>
  <script>
    window.__VIDEO_ID = <%- JSON.stringify(video.youtube_id) %>;
    window.__SLUG = <%- JSON.stringify(video.id) %>;
  </script>
  <script src="/public/embed-tracking.js"></script>
</body>
</html>
